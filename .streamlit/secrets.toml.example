# これは「見本」です。
# このファイルを同じフォルダに secrets.toml という名前でコピーして、
# 中身を自分の値に書き換えてください。
#   .streamlit/secrets.toml.example  →  .streamlit/secrets.toml
#
# secrets.toml は .gitignore 済みなので GitHub には上がりません。

# 保存先: "csv"（ローカル） または "gsheets"（Googleスプレッドシート）
backend = "gsheets"

# 使うスプレッドシート。URL をまるごと貼ってもOK（ID を自動で抜き出します）
spreadsheet_url = "https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxxxxxxxxx/edit"

# シート（タブ）の名前。無ければアプリが自動で作ります。
worksheet_name = "cars"


# ------------------------------------------------------------------
# ↓ Streamlit Community Cloud にデプロイするときだけ使います
#   （ローカルでは token.json ファイルが使われるので不要）
#
#   ローカルで `python scripts/authorize_google.py` を実行して
#   できた .streamlit/token.json の中身を、そのまま貼り付けます。
# ------------------------------------------------------------------
# [google]
# token_json = '''
# {"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "...", "scopes": ["https://www.googleapis.com/auth/spreadsheets"]}
# '''
